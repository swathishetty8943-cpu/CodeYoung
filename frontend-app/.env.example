VITE_API_BASE_URL=http://localhost:5000/api

# --- Firebase (Google sign-in) ---
# These are public client identifiers (safe to expose in the built bundle -
# not secrets like an API/SMTP key). Get them from Firebase Console ->
# Project Settings -> General -> "Your apps" -> Web app -> SDK setup.
# You can also just fill them directly into src/config/firebase.js instead
# of using env vars here - either works, env vars just make it easier to
# use different Firebase projects per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=codeyoung-b618a
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
