PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/codeyoung

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=7d

# --- "Continue with Google" (Firebase) ---
# Just your Firebase project ID - NOT a secret (same value as `projectId`
# in frontend-app/src/config/firebase.js), no service account/private key
# needed. Tokens are verified directly against Google's public keys - see
# backend/src/config/googleAuth.js.
FIREBASE_PROJECT_ID=codeyoung-b618a

# --- Email sending ---
# Recommended: Resend (https://resend.com) via its HTTP API — free tier
# (100 emails/day, 3,000/month), works over normal HTTPS so it isn't
# affected by networks/ISPs that block outbound SMTP ports (a common cause
# of emails hanging or silently failing with the SMTP method below).
#   1. Sign up at https://resend.com and verify your email.
#   2. Dashboard -> API Keys -> Create API Key. Paste it into RESEND_API_KEY.
#   3. For quick testing you can send from onboarding@resend.dev (no domain
#      setup required) — set EMAIL_FROM to that. Note: in this sandbox mode
#      Resend only delivers to the email address you signed up to Resend
#      with; to send to any recipient, verify your own domain under
#      Dashboard -> Domains and use that as EMAIL_FROM instead.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Alternative: SMTP (only used if RESEND_API_KEY above is blank) ---
# Resend also exposes an SMTP endpoint if you'd rather use that:
#   SMTP_HOST=smtp.resend.com / SMTP_PORT=465 / SMTP_USER=resend / SMTP_PASS=<api key>
# Or use any other provider (e.g. SMTP_SERVICE=gmail + a Gmail App Password).
# Leave all of SMTP_*/RESEND_API_KEY blank to keep dev/dummy mode: emails
# are logged to the console instead of sent (see src/services/emailService.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

REMINDER_LEAD_TIME_MINUTES=60
DEFAULT_MAX_CLASSES_PER_MENTOR_PER_DAY=2
SLOT_DURATION_MINUTES=30

FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# --- Parent signup email verification (OTP) ---
SIGNUP_OTP_EXPIRY_MINUTES=10
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_OTP_MAX_ATTEMPTS=5

# Mentors' default password is their own email address (set on creation),
# which they're required to change on first login.

# Set to true to auto-run the mentor seed on server startup (dev only — ignored in production)
AUTO_SEED_ON_STARTUP=true
